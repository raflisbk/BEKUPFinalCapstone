import 'dart:io';
import 'dart:convert';
import 'dart:typed_data';
import 'package:http/http.dart' as http;
import 'package:flutter_dotenv/flutter_dotenv.dart';
import 'package:cloudinary_public/cloudinary_public.dart';
import 'package:crypto/crypto.dart';
import '../core/utils/logger.dart';

/// Cloudinary service to replace Firebase Storage
/// Provides free tier: 25 GB storage, 25 GB bandwidth/month
class CloudinaryService {
  static const String _tag = 'CloudinaryService';
  static final CloudinaryService _instance = CloudinaryService._internal();
  factory CloudinaryService() => _instance;
  CloudinaryService._internal();

  late CloudinaryPublic _cloudinary;
  late String _cloudName;
  late String _apiKey;
  late String _apiSecret;
  late String _uploadPreset;
  bool _isInitialized = false;

  /// Initialize Cloudinary service
  Future<void> initialize() async {
    if (_isInitialized) {
      AppLogger.debug(_tag, 'Already initialized');
      return;
    }

    try {
      _cloudName = dotenv.env['CLOUDINARY_CLOUD_NAME'] ?? '';
      _apiKey = dotenv.env['CLOUDINARY_API_KEY'] ?? '';
      _apiSecret = dotenv.env['CLOUDINARY_API_SECRET'] ?? '';
      _uploadPreset = dotenv.env['CLOUDINARY_UPLOAD_PRESET'] ?? '';

      if (_cloudName.isEmpty || _apiKey.isEmpty || _apiSecret.isEmpty || _uploadPreset.isEmpty) {
        throw Exception('Cloudinary configuration missing in .env file');
      }

      _cloudinary = CloudinaryPublic(_cloudName, _uploadPreset, cache: false);
      _isInitialized = true;

      AppLogger.success(_tag, 'Cloudinary service initialized successfully', {
        'cloudName': _cloudName,
        'uploadPreset': _uploadPreset,
      });
    } catch (e) {
      AppLogger.error(_tag, 'Failed to initialize Cloudinary service', e);
      rethrow;
    }
  }

  /// Upload file to Cloudinary
  /// Returns the secure URL of the uploaded file
  Future<String> uploadFile({
    required File file,
    required String folder,
    String? fileName,
    CloudinaryResourceType resourceType = CloudinaryResourceType.Image,
  }) async {
    _ensureInitialized();

    try {
      AppLogger.info(_tag, 'Uploading file to Cloudinary', {
        'folder': folder,
        'fileName': fileName,
        'resourceType': resourceType.name,
        'fileSize': file.lengthSync(),
      });

      final publicId = fileName ?? _generatePublicId();

      CloudinaryResponse response = await _cloudinary.uploadFile(
        CloudinaryFile.fromFile(
          file.path,
          resourceType: resourceType,
          folder: 'relink/$folder',
          publicId: publicId,
        ),
      );

      final secureUrl = response.secureUrl;
      
      AppLogger.success(_tag, 'File uploaded successfully', {
        'publicId': response.publicId,
        'secureUrl': secureUrl,
      });

      return secureUrl;
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to upload file', e, stackTrace);
      rethrow;
    }
  }

  /// Upload bytes data to Cloudinary
  Future<String> uploadBytes({
    required Uint8List bytes,
    required String folder,
    required String fileName,
    required String mimeType,
    CloudinaryResourceType resourceType = CloudinaryResourceType.Image,
  }) async {
    _ensureInitialized();

    try {
      AppLogger.info(_tag, 'Uploading bytes to Cloudinary', {
        'folder': folder,
        'fileName': fileName,
        'mimeType': mimeType,
        'size': bytes.length,
      });

      final publicId = fileName.split('.').first;
      
      CloudinaryResponse response = await _cloudinary.uploadFile(
        CloudinaryFile.fromBytesData(
          bytes,
          resourceType: resourceType,
          folder: 'relink/$folder',
          publicId: publicId,
        ),
      );

      final secureUrl = response.secureUrl;
      
      AppLogger.success(_tag, 'Bytes uploaded successfully', {
        'publicId': response.publicId,
        'secureUrl': secureUrl,
      });

      return secureUrl;
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to upload bytes', e, stackTrace);
      rethrow;
    }
  }

  /// Upload multiple files to Cloudinary
  Future<List<String>> uploadMultipleFiles({
    required List<File> files,
    required String folder,
    CloudinaryResourceType resourceType = CloudinaryResourceType.Image,
  }) async {
    _ensureInitialized();

    try {
      AppLogger.info(_tag, 'Uploading multiple files', {
        'count': files.length,
        'folder': folder,
      });

      List<String> urls = [];
      
      for (int i = 0; i < files.length; i++) {
        final file = files[i];
        final fileName = '${_generatePublicId()}_$i';
        
        final url = await uploadFile(
          file: file,
          folder: folder,
          fileName: fileName,
          resourceType: resourceType,
        );
        
        urls.add(url);
      }

      AppLogger.success(_tag, 'Multiple files uploaded successfully', {
        'count': urls.length,
        'urls': urls,
      });

      return urls;
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to upload multiple files', e, stackTrace);
      rethrow;
    }
  }

  /// Delete file from Cloudinary
  Future<bool> deleteFile(String publicId) async {
    _ensureInitialized();

    try {
      AppLogger.info(_tag, 'Deleting file from Cloudinary', {
        'publicId': publicId,
      });

      // Generate timestamp and signature for authenticated deletion
      final timestamp = DateTime.now().millisecondsSinceEpoch ~/ 1000;
      final signature = _generateSignature(publicId, timestamp);

      final response = await http.post(
        Uri.parse('https://api.cloudinary.com/v1_1/$_cloudName/image/destroy'),
        body: {
          'public_id': publicId,
          'api_key': _apiKey,
          'timestamp': timestamp.toString(),
          'signature': signature,
        },
      );

      if (response.statusCode == 200) {
        final result = jsonDecode(response.body);
        final success = result['result'] == 'ok';
        
        AppLogger.success(_tag, 'File deletion result', {
          'publicId': publicId,
          'success': success,
          'result': result,
        });

        return success;
      } else {
        AppLogger.error(_tag, 'Failed to delete file', {
          'statusCode': response.statusCode,
          'body': response.body,
        });
        return false;
      }
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to delete file', e, stackTrace);
      return false;
    }
  }

  /// Get optimized image URL with transformations
  String getOptimizedImageUrl({
    required String secureUrl,
    int? width,
    int? height,
    String quality = 'auto',
    String format = 'auto',
    bool progressive = true,
  }) {
    try {
      // Extract public ID from secure URL
      final uri = Uri.parse(secureUrl);
      final pathSegments = uri.pathSegments;
      final uploadIndex = pathSegments.indexOf('upload');
      
      if (uploadIndex == -1) return secureUrl;
      
      final publicIdParts = pathSegments.sublist(uploadIndex + 1);
      final publicId = publicIdParts.join('/');
      
      // Build transformation string
      List<String> transformations = [];
      
      if (width != null) transformations.add('w_$width');
      if (height != null) transformations.add('h_$height');
      transformations.add('q_$quality');
      transformations.add('f_$format');
      if (progressive) transformations.add('fl_progressive');
      
      final transformString = transformations.join(',');
      
      final optimizedUrl = 'https://res.cloudinary.com/$_cloudName/image/upload/$transformString/$publicId';
      
      AppLogger.debug(_tag, 'Generated optimized URL', {
        'original': secureUrl,
        'optimized': optimizedUrl,
        'transformations': transformString,
      });
      
      return optimizedUrl;
      
    } catch (e) {
      AppLogger.error(_tag, 'Failed to generate optimized URL', e);
      return secureUrl;
    }
  }

  /// Upload avatar image with specific optimizations
  Future<String> uploadAvatar({
    required File file,
    required String userId,
  }) async {
    try {
      AppLogger.info(_tag, 'Uploading avatar', {'userId': userId});

      CloudinaryResponse response = await _cloudinary.uploadFile(
        CloudinaryFile.fromFile(
          file.path,
          resourceType: CloudinaryResourceType.Image,
          folder: 'relink/avatars',
          publicId: 'avatar_$userId',
          transformation: CloudinaryTransformation()
            ..width(300)
            ..height(300)
            ..crop('fill')
            ..gravity('face')
            ..quality('auto')
            ..format('auto'),
        ),
      );

      AppLogger.success(_tag, 'Avatar uploaded successfully', {
        'userId': userId,
        'url': response.secureUrl,
      });

      return response.secureUrl;
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to upload avatar', e, stackTrace);
      rethrow;
    }
  }

  /// Upload gallery photo with optimizations
  Future<String> uploadGalleryPhoto({
    required File file,
    required String photoId,
  }) async {
    try {
      AppLogger.info(_tag, 'Uploading gallery photo', {'photoId': photoId});

      CloudinaryResponse response = await _cloudinary.uploadFile(
        CloudinaryFile.fromFile(
          file.path,
          resourceType: CloudinaryResourceType.Image,
          folder: 'relink/gallery',
          publicId: 'photo_$photoId',
          transformation: CloudinaryTransformation()
            ..width(1200)
            ..height(800)
            ..crop('limit')
            ..quality('auto')
            ..format('auto'),
        ),
      );

      AppLogger.success(_tag, 'Gallery photo uploaded successfully', {
        'photoId': photoId,
        'url': response.secureUrl,
      });

      return response.secureUrl;
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to upload gallery photo', e, stackTrace);
      rethrow;
    }
  }

  /// Upload destination cover image
  Future<String> uploadDestinationCover({
    required File file,
    required String destinationId,
  }) async {
    try {
      AppLogger.info(_tag, 'Uploading destination cover', {'destinationId': destinationId});

      CloudinaryResponse response = await _cloudinary.uploadFile(
        CloudinaryFile.fromFile(
          file.path,
          resourceType: CloudinaryResourceType.Image,
          folder: 'relink/destinations',
          publicId: 'cover_$destinationId',
          transformation: CloudinaryTransformation()
            ..width(1920)
            ..height(1080)
            ..crop('fill')
            ..quality('auto')
            ..format('auto'),
        ),
      );

      AppLogger.success(_tag, 'Destination cover uploaded successfully', {
        'destinationId': destinationId,
        'url': response.secureUrl,
      });

      return response.secureUrl;
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to upload destination cover', e, stackTrace);
      rethrow;
    }
  }

  /// Generate signature for authenticated requests
  String _generateSignature(String publicId, int timestamp) {
    final paramsToSign = 'public_id=$publicId&timestamp=$timestamp$_apiSecret';
    final bytes = utf8.encode(paramsToSign);
    final digest = sha1.convert(bytes);
    return digest.toString();
  }

  /// Generate unique public ID
  String _generatePublicId() {
    final timestamp = DateTime.now().millisecondsSinceEpoch;
    final random = (DateTime.now().microsecond * 1000).toString();
    return '${timestamp}_$random';
  }

  /// Ensure service is initialized
  void _ensureInitialized() {
    if (!_isInitialized) {
      throw Exception('Cloudinary service not initialized. Call initialize() first.');
    }
  }

  /// Get usage statistics (requires admin API call)
  Future<Map<String, dynamic>> getUsageStats() async {
    _ensureInitialized();

    try {
      final timestamp = DateTime.now().millisecondsSinceEpoch ~/ 1000;
      final signature = _generateAdminSignature(timestamp);

      final response = await http.get(
        Uri.parse('https://api.cloudinary.com/v1_1/$_cloudName/usage'),
        headers: {
          'Authorization': 'Basic ${base64Encode(utf8.encode('$_apiKey:$_apiSecret'))}',
        },
      );

      if (response.statusCode == 200) {
        final usage = jsonDecode(response.body);
        
        AppLogger.info(_tag, 'Usage statistics retrieved', {
          'plan': usage['plan'],
          'usage': usage['usage'],
        });

        return usage;
      } else {
        AppLogger.error(_tag, 'Failed to get usage stats', {
          'statusCode': response.statusCode,
          'body': response.body,
        });
        return {};
      }
      
    } catch (e, stackTrace) {
      AppLogger.error(_tag, 'Failed to get usage statistics', e, stackTrace);
      return {};
    }
  }

  /// Generate admin signature
  String _generateAdminSignature(int timestamp) {
    final paramsToSign = 'timestamp=$timestamp$_apiSecret';
    final bytes = utf8.encode(paramsToSign);
    final digest = sha1.convert(bytes);
    return digest.toString();
  }
}