# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config files (DO NOT COMMIT THESE)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
web/firebase-config.js

# API Keys and Sensitive Data (CRITICAL SECURITY)
.env
*.env
.env.*
!.env.example
!.env.template

# Local settings and secrets
.vscode/settings.json
.vscode/launch.json
.vs/
*.key
*.pem
*.p12
*.keystore
key.properties

# Sensitive logs and dumps
*.log
*.dump
crash-reports/
debug/

# Platform-specific secrets
android/key.properties
android/upload-keystore.jks
android/app-release.apk
ios/fastlane/report.xml
ios/fastlane/test_output/
ios/Runner.xcworkspace/xcshareddata/
ios/Pods/

# Database and cache files that might contain sensitive data
*.db
*.sqlite
*.sqlite3
cache/
tmp/
temp/

# Ignore all markdown files EXCEPT README.md and docs folder
*.md
!README.md
!FEATURES_CHECKLIST.md
!docs/**/*.md

# Example and template files that are not part of production
example_main_with_di.dart
*_example.dart
*_template.dart
*.example
*.template

*.pdf
.pdf
nul