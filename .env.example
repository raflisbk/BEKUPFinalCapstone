# ===============================================
# RELINK - ENVIRONMENT VARIABLES TEMPLATE
# ===============================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to version control
# 4. Use different values for development/production
# ===============================================

# -----------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------
APP_NAME=ReLink
APP_VERSION=4.1.0
ENVIRONMENT=development
DEBUG_MODE=true

# -----------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------
# Generate strong random keys for production
APP_SECRET_KEY=your-app-secret-key-min-32-chars
JWT_SECRET=your-jwt-secret-key-min-32-chars
ENCRYPTION_SALT=your-encryption-salt-key

# -----------------------------------------------
# SUPABASE - 100% FREE BACKEND (Replaces Firebase)
# -----------------------------------------------
# Get from: https://supabase.com/dashboard/project/_/settings/api
# FREE TIER: 2 projects, 500MB database, 1GB file storage, 50MB file uploads
# UNLIMITED: API requests, Authentication users, Realtime connections
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------
# MAPBOX - FREE MAPS & NAVIGATION (Replaces Google Maps)
# -----------------------------------------------
# Get from: https://account.mapbox.com/access-tokens/
# FREE TIER: 50,000 map loads + 100,000 directions requests per month
# $2,040/year SAVINGS compared to Google Maps at scale
MAPBOX_PUBLIC_TOKEN=pk.your-mapbox-public-token
MAPBOX_SECRET_TOKEN=sk.your-mapbox-secret-token

# -----------------------------------------------
# CLOUDINARY - FREE MEDIA STORAGE (Replaces Firebase Storage)
# -----------------------------------------------
# Get from: https://cloudinary.com/console
# FREE TIER: 25GB storage, 25GB bandwidth, 25 credits/month
# Advanced image/video optimization included
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# -----------------------------------------------
# ONESIGNAL - FREE PUSH NOTIFICATIONS (Replaces Firebase Messaging)
# -----------------------------------------------
# Get from: https://onesignal.com/
# FREE TIER: Unlimited push notifications for up to 10,000 subscribers
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# -----------------------------------------------
# OPENROUTE SERVICE - FREE ROUTING ALTERNATIVE
# -----------------------------------------------
# Get from: https://openrouteservice.org/dev/#/signup
# FREE TIER: 2,000 requests per day
OPENROUTE_API_KEY=your-openroute-api-key

# -----------------------------------------------
# OPENWEATHER API - FREE WEATHER DATA
# -----------------------------------------------
# Get from: https://openweathermap.org/api
# FREE TIER: 1,000 calls per day
OPENWEATHER_API_KEY=your-openweather-api-key

# -----------------------------------------------
# GEMINI AI - FREE AI SERVICES (Optional)
# -----------------------------------------------
# Get from: https://makersuite.google.com/app/apikey
# FREE TIER: 15 requests per minute
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------
# GOOGLE MAPS API (BACKUP - NOT RECOMMENDED DUE TO COSTS)
# -----------------------------------------------
# Only use if Mapbox fails - very expensive at scale
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------
# DATABASE SETTINGS (For local development)
# -----------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=relink_dev
DB_USERNAME=postgres
DB_PASSWORD=your-local-db-password

# -----------------------------------------------
# REDIS CACHE (Optional for performance)
# -----------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# -----------------------------------------------
# EMAIL SERVICE (Optional)
# -----------------------------------------------
# Use free tier from services like SendGrid, Mailgun, etc.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@yourapp.com

# -----------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------
# Use Google Analytics 4 (free) or Mixpanel free tier
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# -----------------------------------------------
# PAYMENT PROCESSING (Optional)
# -----------------------------------------------
# Stripe has generous free tier, PayPal also has free options
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# -----------------------------------------------
# SOCIAL LOGIN (Optional)
# -----------------------------------------------
# Most providers have free tiers for small apps
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# -----------------------------------------------
# MONITORING & LOGGING (Optional)
# -----------------------------------------------
# Sentry has generous free tier for error tracking
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info

# ===============================================
# COST SAVINGS SUMMARY WITH FREE STACK:
# ===============================================
# Firebase (Database + Auth + Storage): $25-100/month
# Google Maps API: $200+/month at scale  
# Firebase Cloud Messaging: $1-10/month
# Total Monthly Cost: $226-310/month
# Total Yearly Cost: $2,712-3,720/year
#
# FREE ALTERNATIVES USED:
# Supabase: $0/month (500MB DB + 1GB storage)
# Mapbox: $0/month (50K map loads + 100K directions)
# Cloudinary: $0/month (25GB storage + optimization)
# OneSignal: $0/month (unlimited notifications)
# Total Monthly Cost: $0/month
# Total Yearly Savings: $2,712-3,720/year
# ===============================================
